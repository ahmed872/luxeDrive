# LuxeDrive — environment contract
#
# Copy to `.env` for local development. Never commit a filled-in copy: `.env`,
# `.env.test` and `.env.*.local` are gitignored.
#
# Two rules govern this file:
#   1. Anything named NEXT_PUBLIC_* is inlined into the browser bundle by
#      Next.js and is public forever. A secret must never carry that prefix —
#      `parseServerEnv` throws at boot if one does.
#   2. Every variable below is validated on startup by
#      src/modules/core/env.schema.ts. An invalid or missing value fails fast
#      instead of surfacing as a confusing error on the first request.

# ---------------------------------------------------------------------------
# Server — secret. Never exposed to the browser.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local development (this repo's docs/environments.md explains the local setup):
DATABASE_URL="postgresql://luxedrive:CHANGE_ME@127.0.0.1:5432/luxedrive_dev?schema=public"

# NODE_ENV is set by the tooling (development | test | production).
# Only override it deliberately.
# NODE_ENV="development"

# ---------------------------------------------------------------------------
# Media storage (P04) — local by default, so a fresh checkout works with no
# object-storage account. Switch STORAGE_PROVIDER to "s3" for any real
# S3-compatible provider (AWS S3, R2, MinIO, Wasabi, …); the four STORAGE_*
# values below become required at boot the moment you do.
# ---------------------------------------------------------------------------

STORAGE_PROVIDER="local"

# local provider only — required. A generated random value, 32+ characters,
# signs local upload URLs the way AWS credentials sign a real presigned one.
MEDIA_UPLOAD_SIGNING_SECRET="CHANGE_ME_32_CHARS_MINIMUM_RANDOM_VALUE"

# local provider only — where uploaded files land on disk. Gitignored; safe
# to delete, it regenerates from re-running the media migration/uploads.
# MEDIA_LOCAL_STORAGE_DIR=".local-storage/media"

# s3 provider — all four required once STORAGE_PROVIDER="s3":
# STORAGE_BUCKET=""
# STORAGE_ENDPOINT=""             # omit for real AWS S3; set for R2/MinIO/Wasabi/etc.
# STORAGE_REGION=""
# STORAGE_ACCESS_KEY_ID=""        # secret
# STORAGE_SECRET_ACCESS_KEY=""    # secret

# Either provider — optional. The public delivery base (ideally a CDN
# domain fronting the bucket). Falls back to a provider-appropriate default
# (the local media route, or the bucket's own endpoint) when unset.
# MEDIA_PUBLIC_BASE_URL=""

# ---------------------------------------------------------------------------
# Authentication (P06) — Auth.js, admin sign-in only. Every value here is
# secret; a live admin session's validity depends on AUTH_SECRET never
# leaking (it signs/encrypts the session JWT).
# ---------------------------------------------------------------------------

# Required. 32+ random characters — generate with `openssl rand -base64 32`.
# Rotating this immediately invalidates every existing session (by design;
# see docs/environments.md).
AUTH_SECRET="CHANGE_ME_32_CHARS_MINIMUM_RANDOM_VALUE"

# Optional. Set to "true" only when deployed behind a reverse proxy Auth.js
# should trust for the request's host/protocol (a real production deploy
# behind a load balancer/CDN). Leave unset locally.
# AUTH_TRUST_HOST="true"

# Script-only — read exclusively by `pnpm db:create-admin`
# (scripts/create-admin.mts), never by the running app. Required only for
# the one invocation that bootstraps the first admin account; unset them
# again afterwards if you like. Never commit real values, even here.
# BOOTSTRAP_ADMIN_EMAIL="owner@example.com"
# BOOTSTRAP_ADMIN_PASSWORD="a real, unique password — 12+ characters"

# ---------------------------------------------------------------------------
# Client — public by definition. Safe to read from browser JavaScript.
# ---------------------------------------------------------------------------

# Must match the exact host the app is actually reached on, not just an
# equivalent address — `localhost` and `127.0.0.1` both resolve to the same
# loopback interface but are different hosts for cookie scoping, and P11's
# payment return URL is built from this value. Playwright's e2e config
# standardises on `127.0.0.1` (see `playwright.config.ts`), so local e2e runs
# need this set the same way, or a guest's session cookie is scoped to one
# host while the payment provider redirects back to the other and the
# order becomes unreachable after paying.
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3000"

# Arabic is the default storefront locale (ADR-023): `/` redirects to `/ar/`.
NEXT_PUBLIC_DEFAULT_LOCALE="ar"

# ---------------------------------------------------------------------------
# Payments (P11)
# ---------------------------------------------------------------------------

# Which payment adapter runs.
#
#   none             payments are switched off. A supported configuration and
#                    the default: the app boots, and checkout says payment is
#                    unavailable instead of offering a button that cannot work.
#   hosted_checkout  the provider-agnostic hosted-checkout adapter shipped in
#                    P11 — the provider hosts the payment page, this
#                    application never sees card data, and outcomes arrive as
#                    HMAC-signed webhooks.
#
# Adding a named vendor (Tap, Paymob, Stripe) means one file implementing
# `PaymentProviderAdapter` and one enum value — no change to the order domain.
PAYMENT_PROVIDER="none"

# Required when PAYMENT_PROVIDER is not "none". Sandbox and live differ.
# PAYMENT_API_BASE_URL="https://api.example-psp.com/v1"

# Secret. Bearer credential for the provider's API. Never logged, never sent
# to the browser, never stored on a payment row.
# PAYMENT_API_KEY=""

# Secret. The HMAC-SHA256 key the provider signs its webhooks with — the only
# thing standing between the payment domain and anyone who can POST to
# /api/payments/webhook/hosted_checkout. There is no "verification off" mode.
# Generate with: openssl rand -hex 32
# PAYMENT_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Reserved for later phases — documented here so the contract is visible, but
# not yet read by any code. Adding them to the schema before the feature exists
# would fail the build for no reason.
# ---------------------------------------------------------------------------

# P13 — notification delivery
# EMAIL_API_KEY=""                # secret
# EMAIL_FROM=""
