# LuxeDrive — environment contract
#
# Copy to `.env` for local development. Never commit a filled-in copy: `.env`,
# `.env.test` and `.env.*.local` are gitignored.
#
# Two rules govern this file:
#   1. Anything named NEXT_PUBLIC_* is inlined into the browser bundle by
#      Next.js and is public forever. A secret must never carry that prefix —
#      `parseServerEnv` throws at boot if one does.
#   2. Every variable below is validated on startup by
#      src/modules/core/env.schema.ts. An invalid or missing value fails fast
#      instead of surfacing as a confusing error on the first request.

# ---------------------------------------------------------------------------
# Server — secret. Never exposed to the browser.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local development (this repo's docs/environments.md explains the local setup):
DATABASE_URL="postgresql://luxedrive:CHANGE_ME@127.0.0.1:5432/luxedrive_dev?schema=public"

# NODE_ENV is set by the tooling (development | test | production).
# Only override it deliberately.
# NODE_ENV="development"

# ---------------------------------------------------------------------------
# Client — public by definition. Safe to read from browser JavaScript.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Arabic is the default storefront locale (ADR-023): `/` redirects to `/ar/`.
NEXT_PUBLIC_DEFAULT_LOCALE="ar"

# ---------------------------------------------------------------------------
# Reserved for later phases — documented here so the contract is visible, but
# not yet read by any code. Adding them to the schema before the feature exists
# would fail the build for no reason.
# ---------------------------------------------------------------------------

# P06 — authentication
# AUTH_SECRET=""                  # session signing key, secret

# P04 — media storage (S3-compatible)
# STORAGE_ENDPOINT=""
# STORAGE_BUCKET=""
# STORAGE_ACCESS_KEY_ID=""        # secret
# STORAGE_SECRET_ACCESS_KEY=""    # secret

# P11 — payments and webhooks
# PAYMENT_PROVIDER=""             # paymob | tap | stripe
# PAYMENT_API_KEY=""              # secret
# PAYMENT_WEBHOOK_SECRET=""       # secret, used to verify callback signatures

# P11 — notifications
# EMAIL_API_KEY=""                # secret
# EMAIL_FROM=""
